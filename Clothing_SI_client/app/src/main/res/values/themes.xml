<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClothingSI" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <!-- 保持状态栏图标为深色（在浅色背景上可见） -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- 全局字体：sans-serif 为系统默认清晰字体 -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textViewStyle">@style/TextView.Base</item>
    </style>

    <style name="TextView.Base" parent="android:Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
