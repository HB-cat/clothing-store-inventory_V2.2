<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/md_surface_container_low">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/md_surface" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/btn_back" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="‹ 返回"
            android:textSize="16sp" android:textColor="@color/md_on_surface" android:padding="8dp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="程序设置"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/md_on_surface"
            android:gravity="center" android:layout_marginEnd="60dp"
            android:id="@+id/tv_title" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- 数据同步 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="数据同步" android:textSize="13sp" android:textColor="@color/md_on_surface_variant"
                android:layout_marginBottom="6dp" android:layout_marginStart="4dp" />
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                app:cardElevation="1dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="4dp">
                    <LinearLayout android:id="@+id/settings_sync"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="同步数据到云端"
                            android:textSize="14sp" android:textColor="@color/md_on_surface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="16sp" android:textColor="@color/md_outline" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 首页状态文字 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="首页状态栏" android:textSize="13sp" android:textColor="@color/md_on_surface_variant"
                android:layout_marginBottom="6dp" android:layout_marginStart="4dp"
                android:layout_marginTop="10dp" />
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                app:cardElevation="1dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="自定义首页提示文字"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_home_status"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:maxLines="2" android:inputType="text" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_home_status"
                        android:layout_width="wrap_content" android:layout_height="40dp"
                        android:text="保存" android:textSize="14sp" app:cornerRadius="20dp"
                        android:backgroundTint="@color/md_primary"
                        android:textColor="@color/md_on_primary"
                        android:layout_gravity="end" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 通知管理 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="通知管理" android:textSize="13sp" android:textColor="@color/md_on_surface_variant"
                android:layout_marginBottom="6dp" android:layout_marginStart="4dp" />
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                app:cardElevation="1dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="操作音效"
                            android:textSize="14sp" android:textColor="@color/md_on_surface" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_sound" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:checked="true" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/md_outline_variant" android:layout_marginStart="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="智能体建议"
                            android:textSize="14sp" android:textColor="@color/md_on_surface" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_notify_agent" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:checked="true" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/md_outline_variant" android:layout_marginStart="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="预约通知"
                            android:textSize="14sp" android:textColor="@color/md_on_surface" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_notify_appt" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:checked="true" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/md_outline_variant" android:layout_marginStart="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="聊天通知"
                            android:textSize="14sp" android:textColor="@color/md_on_surface" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_notify_chat" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:checked="true" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
