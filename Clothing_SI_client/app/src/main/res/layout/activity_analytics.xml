<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/header_bar_bg" android:paddingHorizontal="16dp">
            <TextView android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp"
                android:text="‹" android:textSize="20dp" android:textColor="@color/text_primary"
                android:gravity="center" android:background="@drawable/circle_bg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="经营分析" android:textSize="17dp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_centerInParent="true" />
        </RelativeLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. 今日快报 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📋 今日快报" android:textSize="16dp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                    app:cardElevation="0dp" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tv_today_conclusion" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="加载中..."
                            android:textSize="24dp" android:textStyle="bold" android:textColor="@color/primary"
                            android:fontFamily="sans-serif" />
                        <TextView android:id="@+id/tv_today_detail" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text=""
                            android:textSize="13dp" android:textColor="@color/text_secondary"
                            android:layout_marginTop="4dp" android:fontFamily="sans-serif" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. 补货建议 (折叠) -->
                <LinearLayout android:id="@+id/toggle_low_stock" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingVertical="6dp">
                    <TextView android:id="@+id/tv_low_stock_title" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="⚠️ 补货建议" android:textSize="16dp" android:textStyle="bold"
                        android:textColor="@color/text_primary" android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/iv_low_stock_arrow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▼" android:textSize="14dp"
                        android:textColor="@color/text_light" />
                </LinearLayout>
                <androidx.cardview.widget.CardView android:id="@+id/card_low_stock"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp" android:layout_marginBottom="12dp">
                    <LinearLayout android:id="@+id/layout_low_stock" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:padding="16dp" />
                </androidx.cardview.widget.CardView>

                <!-- 3. 滞销提醒 (折叠) -->
                <LinearLayout android:id="@+id/toggle_slow_moving" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingVertical="6dp">
                    <TextView android:id="@+id/tv_slow_moving_title" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="📦 滞销提醒" android:textSize="16dp" android:textStyle="bold"
                        android:textColor="@color/text_primary" android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/iv_slow_moving_arrow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▼" android:textSize="14dp"
                        android:textColor="@color/text_light" />
                </LinearLayout>
                <androidx.cardview.widget.CardView android:id="@+id/card_slow_moving"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp" android:layout_marginBottom="12dp">
                    <LinearLayout android:id="@+id/layout_slow_moving" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:padding="16dp" />
                </androidx.cardview.widget.CardView>

                <!-- 4. 热销TOP8 (折叠, 点击卡片进入横屏) -->
                <LinearLayout android:id="@+id/toggle_top_products" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="🔥 热销TOP8"
                        android:textSize="16dp" android:textStyle="bold" android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/iv_top_arrow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▼" android:textSize="14dp"
                        android:textColor="@color/text_light" />
                </LinearLayout>
                <androidx.cardview.widget.CardView android:id="@+id/card_top_products"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp" android:layout_marginBottom="12dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tv_top_conclusion" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="加载中..."
                            android:textSize="13dp" android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" android:fontFamily="sans-serif" />
                        <TextView android:id="@+id/layout_top_products" android:layout_width="match_parent"
                            android:layout_height="100dp" android:text="点击查看热销TOP8 柱状图 ›"
                            android:textSize="14dp" android:textColor="@color/primary" android:gravity="center"
                            android:padding="20dp" android:background="@drawable/chart_bg"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 5. 近7天趋势 (折叠, 点击卡片进入横屏) -->
                <LinearLayout android:id="@+id/toggle_trend" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📈 近7天销售趋势"
                        android:textSize="16dp" android:textStyle="bold" android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/iv_trend_arrow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▼" android:textSize="14dp"
                        android:textColor="@color/text_light" />
                </LinearLayout>
                <androidx.cardview.widget.CardView android:id="@+id/card_trend"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp" android:layout_marginBottom="12dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tv_trend_conclusion" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="加载中..."
                            android:textSize="13dp" android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" android:fontFamily="sans-serif" />
                        <TextView android:layout_width="match_parent" android:layout_height="100dp"
                            android:text="点击查看近7天趋势 折线图 ›" android:textSize="14dp" android:textColor="@color/primary"
                            android:gravity="center" android:padding="20dp" android:background="@color/bg"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 6. 订单高峰 (折叠, 点击卡片进入横屏) -->
                <LinearLayout android:id="@+id/toggle_peak" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="⏰ 订单高峰"
                        android:textSize="16dp" android:textStyle="bold" android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/iv_peak_arrow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▼" android:textSize="14dp"
                        android:textColor="@color/text_light" />
                </LinearLayout>
                <androidx.cardview.widget.CardView android:id="@+id/card_peak"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp" android:layout_marginBottom="12dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tv_peak_conclusion" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="加载中..."
                            android:textSize="13dp" android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" android:fontFamily="sans-serif" />
                        <TextView android:layout_width="match_parent" android:layout_height="100dp"
                            android:text="点击查看订单高峰 柱状图 ›" android:textSize="14dp" android:textColor="@color/primary"
                            android:gravity="center" android:padding="20dp" android:background="@color/bg"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 7. 客户画像 (折叠, 点击卡片进入横屏) -->
                <LinearLayout android:id="@+id/toggle_profile" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:clickable="true" android:focusable="true"
                    android:paddingVertical="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="👥 客户画像"
                        android:textSize="16dp" android:textStyle="bold" android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif" />
                    <TextView android:id="@+id/iv_profile_arrow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▼" android:textSize="14dp"
                        android:textColor="@color/text_light" />
                </LinearLayout>
                <androidx.cardview.widget.CardView android:id="@+id/card_profile"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp" android:layout_marginBottom="12dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tv_profile_conclusion" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="加载中..."
                            android:textSize="13dp" android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" android:fontFamily="sans-serif" />
                        <TextView android:layout_width="match_parent" android:layout_height="100dp"
                            android:text="点击查看客户画像 饼图 ›" android:textSize="14dp" android:textColor="@color/primary"
                            android:gravity="center" android:padding="20dp" android:background="@color/bg"
                            android:fontFamily="sans-serif" />
                        <LinearLayout android:id="@+id/layout_customer_profile"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
