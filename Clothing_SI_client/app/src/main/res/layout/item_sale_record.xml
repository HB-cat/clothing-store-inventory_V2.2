<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="14dp" android:paddingBottom="14dp"
    android:paddingStart="16dp" android:paddingEnd="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_record_product"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15dp" android:textStyle="bold" android:textColor="#2D3436" />
        <TextView android:id="@+id/tv_record_info"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12dp" android:textColor="#95A5A6" android:layout_marginTop="2dp" />
    </LinearLayout>
    <TextView android:id="@+id/tv_record_amount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="15dp" android:textStyle="bold" android:textColor="#E74C3C" />
</LinearLayout>
