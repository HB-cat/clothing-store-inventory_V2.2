<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/header_bar_bg" android:paddingHorizontal="16dp">
            <TextView android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp"
                android:text="‹" android:textSize="20dp" android:textColor="#FFFFFF"
                android:gravity="center" android:background="@drawable/circle_bg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="快速记账" android:textSize="17dp" android:textStyle="bold"
                android:textColor="#FFFFFF" android:layout_centerInParent="true" />
        </RelativeLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <!-- 选择商品 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="选择商品" android:textSize="13dp" android:textStyle="bold"
                    android:textColor="#95A5A6" android:layout_marginBottom="4dp" />
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout android:id="@+id/layout_product_selector"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="12dp" android:clickable="true" android:focusable="true">
                        <TextView android:id="@+id/tv_product_emoji" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="👕" android:textSize="24dp"
                            android:layout_marginEnd="8dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tv_selected_product" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="纯棉圆领T恤 · 白色M"
                                android:textSize="14dp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:id="@+id/tv_product_stock" android:text="库存：23"
                                android:textSize="11dp" android:textColor="#95A5A6" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center" android:padding="4dp"
                            android:background="@drawable/stepper_bg"
                            android:id="@+id/layout_qty_stepper">
                            <TextView android:id="@+id/btn_qty_minus" android:layout_width="28dp" android:layout_height="28dp"
                                android:text="−" android:textSize="16dp" android:gravity="center"
                                android:background="@drawable/circle_bg" android:clickable="true" android:focusable="true" />
                            <TextView android:id="@+id/tv_qty" android:layout_width="24dp" android:layout_height="wrap_content"
                                android:text="1" android:textSize="16dp" android:textStyle="bold" android:gravity="center" />
                            <TextView android:id="@+id/btn_qty_plus" android:layout_width="28dp" android:layout_height="28dp"
                                android:text="+" android:textSize="16dp" android:gravity="center"
                                android:background="@drawable/circle_bg" android:clickable="true" android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 买家 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="买家" android:textSize="13dp" android:textStyle="bold"
                    android:textColor="#95A5A6" android:layout_marginBottom="4dp" />
                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinner_buyer"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/segment_bg"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp"
                    android:entries="@array/buyer_options" />

                <!-- 实付金额 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="实付金额（¥）" android:textSize="13dp" android:textStyle="bold"
                    android:textColor="#95A5A6" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_price"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="输入金额" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 备注 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="备注" android:textSize="13dp" android:textStyle="bold"
                    android:textColor="#95A5A6" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_note"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="选填" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton android:id="@+id/btn_submit_sale"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="确认记账" android:textSize="16dp" app:cornerRadius="28dp"
                    android:backgroundTint="#E85D3A" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
