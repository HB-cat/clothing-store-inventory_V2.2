<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface_container_low">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/header_bar_bg"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="36dp" android:layout_height="36dp"
                android:text="‹"
                android:textSize="20sp"
                android:textColor="@color/md_on_surface"
                android:gravity="center"
                android:background="@drawable/circle_bg" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="快速记账"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/md_on_surface"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ===== 选择商品 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择商品"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface_variant"
                    android:layout_marginBottom="6dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:id="@+id/layout_product_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:clickable="true" android:focusable="true">
                        <TextView
                            android:id="@+id/tv_product_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👕"
                            android:textSize="26sp"
                            android:layout_marginEnd="10dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_selected_product"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="点击选择商品"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/md_on_surface" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tv_product_stock"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="@color/md_on_surface_variant" />
                        </LinearLayout>
                        <!-- 数量步进器 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:padding="4dp"
                            android:background="@drawable/stepper_bg"
                            android:id="@+id/layout_qty_stepper">
                            <TextView
                                android:id="@+id/btn_qty_minus"
                                android:layout_width="28dp" android:layout_height="28dp"
                                android:text="−"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:background="@drawable/circle_bg"
                                android:textColor="@color/md_on_surface_variant"
                                android:clickable="true" android:focusable="true" />
                            <TextView
                                android:id="@+id/tv_qty"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textColor="@color/md_on_surface" />
                            <TextView
                                android:id="@+id/btn_qty_plus"
                                android:layout_width="28dp" android:layout_height="28dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:background="@drawable/circle_bg"
                                android:textColor="@color/md_primary"
                                android:clickable="true" android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== 买家 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="买家"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface_variant"
                    android:layout_marginBottom="6dp" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinner_buyer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/segment_bg"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp"
                    android:entries="@array/buyer_options" />

                <!-- ===== 实付金额 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="实付金额（¥）"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface_variant"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/md_primary"
                    app:boxStrokeWidth="1.5dp"
                    android:layout_marginBottom="16dp"
                    android:hint="输入金额">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===== 备注 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="备注"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface_variant"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/md_outline"
                    app:boxStrokeWidth="1dp"
                    android:layout_marginBottom="24dp"
                    android:hint="选填">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===== 确认记账 ===== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit_sale"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="确认记账"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    android:backgroundTint="@color/md_primary"
                    android:textColor="@color/md_on_primary" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
