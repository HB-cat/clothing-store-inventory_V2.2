<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@color/primary_dark"
            android:paddingHorizontal="12dp">

            <TextView android:id="@+id/btn_back"
                android:layout_width="36dp" android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:text="✕" android:textSize="18dp"
                android:textColor="@color/white" android:gravity="center"
                android:background="@drawable/circle_bg"
                android:layout_alignParentStart="true" />

            <TextView android:id="@+id/tv_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="图表" android:textSize="17dp"
                android:textStyle="bold" android:textColor="@color/white" />
        </RelativeLayout>

        <!-- 图表区域 -->
        <com.heben.client.view.ChartView
            android:id="@+id/chart_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</FrameLayout>
