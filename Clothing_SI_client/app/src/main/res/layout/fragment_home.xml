<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/bg">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Shop Name + Subtitle -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="欣欣服装店" android:textSize="24dp" android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="零售商 · 欢迎回来" android:textSize="13dp"
                android:textColor="@color/text_secondary" android:layout_marginBottom="12dp" />

            <!-- 快捷指令输入框 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="28dp" app:cardElevation="2dp"
                android:layout_marginBottom="14dp" app:strokeWidth="0dp">
                <EditText android:id="@+id/et_quick_cmd"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingVertical="12dp" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:hint="💡 试试：卖了2件白T恤 或 新建账单..."
                    android:background="@android:color/transparent" android:textSize="14dp"
                    android:focusable="true" android:focusableInTouchMode="true" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 静态文字栏（用户可在程序设置中自定义） -->
            <TextView android:id="@+id/tv_home_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/home_status_text"
                android:textSize="13dp" android:textColor="@color/primary_dark"
                android:textStyle="bold" android:gravity="center"
                android:background="@color/primary_light"
                android:paddingVertical="8dp" android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="32dp" android:layout_marginBottom="14dp" />

            <!-- 快捷操作 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center"
                android:layout_marginBottom="16dp" android:weightSum="3">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_purchase"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center"
                        android:paddingVertical="14dp" android:paddingHorizontal="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📦" android:textSize="26dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="进货" android:textSize="12dp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_new_order"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center"
                        android:paddingVertical="14dp" android:paddingHorizontal="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📋" android:textSize="26dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="新建订单" android:textSize="12dp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_sale"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center"
                        android:paddingVertical="14dp" android:paddingHorizontal="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💰" android:textSize="26dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="记账" android:textSize="12dp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- 待办事项 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📋 待办事项" android:textSize="16dp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="10dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/todo_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingVertical="12dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📄" android:textSize="20dp" android:layout_marginEnd="10dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="有 2 个未提交账单" android:textSize="14dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="待处理" android:background="#FFF3E0" android:textColor="#E65100"
                        android:paddingVertical="2dp" android:paddingHorizontal="6dp"
                        android:textSize="10dp" android:layout_marginEnd="4dp" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="24dp"
                        android:text="去处理" android:textSize="10dp"
                        android:minWidth="0dp" android:paddingHorizontal="6dp"
                        android:gravity="center"
                        android:background="@drawable/segment_tab_bg"
                        android:textColor="@color/primary" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 今日推荐 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔥 今日推荐" android:textSize="16dp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="近期热卖" android:textSize="12dp" android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="3"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center"
                        android:paddingVertical="14dp" android:paddingHorizontal="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="👕" android:textSize="32dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="纯棉圆领T恤" android:textSize="12dp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="白色M · ¥65" android:textSize="10dp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="月售 32 件" android:textSize="10dp" android:textColor="@color/danger"
                            android:background="#FFEBEE"
                            android:paddingVertical="1dp" android:paddingHorizontal="6dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="5dp"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center"
                        android:paddingVertical="14dp" android:paddingHorizontal="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="👗" android:textSize="32dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="碎花雪纺连衣裙" android:textSize="12dp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="蓝色M · ¥120" android:textSize="10dp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="月售 18 件" android:textSize="10dp" android:textColor="@color/danger"
                            android:background="#FFEBEE"
                            android:paddingVertical="1dp" android:paddingHorizontal="6dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="5dp"
                    app:cardCornerRadius="20dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center"
                        android:paddingVertical="14dp" android:paddingHorizontal="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="👖" android:textSize="32dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="高腰阔腿牛仔裤" android:textSize="12dp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="浅蓝27 · ¥130" android:textSize="10dp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="月售 12 件" android:textSize="10dp" android:textColor="@color/danger"
                            android:background="#FFEBEE"
                            android:paddingVertical="1dp" android:paddingHorizontal="6dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
