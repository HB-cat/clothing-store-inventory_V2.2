<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F5F5">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@drawable/header_bar_bg" android:paddingHorizontal="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="消息" android:textSize="17dp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:layout_centerInParent="true" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- 最近预约 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📅 最近预约" android:textSize="15dp" android:textStyle="bold"
                android:textColor="#2D3436" android:layout_marginBottom="8dp" />
            <LinearLayout android:id="@+id/layout_appointments"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="16dp" />

            <!-- 最近聊天 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💬 最近聊天" android:textSize="15dp" android:textStyle="bold"
                android:textColor="#2D3436" android:layout_marginBottom="8dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_buyer_sessions"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部导航 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center"
        android:paddingVertical="10dp" android:background="#FFFFFF"
        android:weightSum="3" android:elevation="4dp">
        <TextView android:id="@+id/bottom_home" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center" android:text="首页" android:textColor="#95A5A6"
            android:textSize="13dp" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center" android:text="消息" android:textColor="#E85D3A"
            android:textStyle="bold" android:textSize="13dp" />
        <TextView android:id="@+id/bottom_profile" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:gravity="center" android:text="我的"
            android:textColor="#95A5A6" android:textSize="13dp"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
