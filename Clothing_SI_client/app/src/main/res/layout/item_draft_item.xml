<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingVertical="10dp" android:paddingHorizontal="16dp">

    <TextView android:id="@+id/tv_draft_item_thumb" android:layout_width="40dp" android:layout_height="40dp"
        android:gravity="center" android:text="👕" android:textSize="20sp"
        android:background="@color/md_primary_container" android:layout_marginEnd="10dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_draft_item_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/md_on_surface" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="2dp">
            <TextView android:id="@+id/tv_draft_item_qty" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/md_primary" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tv_draft_item_price" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/md_on_surface_variant" android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="✕" android:textSize="14sp" android:textColor="@color/md_error"
        android:layout_marginStart="8dp" android:clickable="true" android:focusable="true"
        android:padding="4dp" />
</LinearLayout>
