<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/md_surface_container_low">

        <!-- Top bar -->
        <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/header_bar_bg" android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="账单" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/md_on_surface" android:layout_centerInParent="true" />
            <TextView android:layout_width="36dp" android:layout_height="36dp"
                android:text="+" android:textSize="20sp" android:textColor="@color/md_on_surface"
                android:gravity="center" android:background="@drawable/circle_bg"
                android:layout_alignParentEnd="true" android:clickable="true"
                android:id="@+id/fab_add_sale" />
        </RelativeLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <!-- ===== 日期选择器（芯片组） ===== -->
                <LinearLayout android:id="@+id/date_selector"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@color/md_surface_container"
                    android:paddingHorizontal="14dp"
                    android:clickable="true" android:focusable="true"
                    android:layout_marginBottom="10dp">

                    <TextView android:id="@+id/tv_date_label" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="📅 今日" android:textSize="14sp"
                        android:textColor="@color/md_on_surface" android:textStyle="bold" />

                    <!-- 快捷芯片组 -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center"
                        android:id="@+id/preset_row">
                        <TextView android:id="@+id/chip_today"
                            android:layout_width="wrap_content" android:layout_height="30dp"
                            android:gravity="center" android:text="今日" android:textSize="12sp"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/segment_tab_bg"
                            android:textColor="@color/md_primary" android:layout_marginEnd="4dp" />
                        <TextView android:id="@+id/chip_month"
                            android:layout_width="wrap_content" android:layout_height="30dp"
                            android:gravity="center" android:text="本月" android:textSize="12sp"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/segment_tab_bg"
                            android:textColor="@color/md_on_surface_variant" android:layout_marginHorizontal="4dp" />
                        <TextView android:id="@+id/chip_year"
                            android:layout_width="wrap_content" android:layout_height="30dp"
                            android:gravity="center" android:text="本年" android:textSize="12sp"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/segment_tab_bg"
                            android:textColor="@color/md_on_surface_variant" android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▼" android:textSize="11sp" android:textColor="@color/md_on_surface_variant"
                        android:id="@+id/tv_date_arrow" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- ===== 统计卡片 ===== -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center"
                    android:layout_marginBottom="12dp" android:weightSum="3">

                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="5dp"
                        app:cardCornerRadius="12dp" app:cardElevation="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center" android:paddingVertical="14dp" android:paddingHorizontal="6dp">
                            <TextView android:id="@+id/tv_sales_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="¥0" android:textSize="19sp" android:textStyle="bold"
                                android:textColor="@color/md_primary" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="销售额" android:textSize="11sp" android:textColor="@color/md_on_surface_variant" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginHorizontal="5dp"
                        app:cardCornerRadius="12dp" app:cardElevation="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center" android:paddingVertical="14dp" android:paddingHorizontal="6dp">
                            <TextView android:id="@+id/tv_sales_profit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="¥0" android:textSize="19sp" android:textStyle="bold"
                                android:textColor="@color/md_secondary" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="毛利" android:textSize="11sp" android:textColor="@color/md_on_surface_variant" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="5dp"
                        app:cardCornerRadius="12dp" app:cardElevation="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center" android:paddingVertical="14dp" android:paddingHorizontal="6dp">
                            <TextView android:id="@+id/tv_sales_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textSize="19sp" android:textStyle="bold"
                                android:textColor="@color/md_on_surface" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="笔数" android:textSize="11sp" android:textColor="@color/md_on_surface_variant" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- ===== 草稿账单 ===== -->
                <androidx.cardview.widget.CardView android:id="@+id/card_draft"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp" app:cardElevation="1dp" android:layout_marginBottom="12dp"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:paddingVertical="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                        <View android:layout_width="4dp" android:layout_height="40dp"
                            android:background="#F9A825" android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tv_draft_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/md_on_surface" />
                            <TextView android:id="@+id/tv_draft_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="12sp" android:textColor="@color/md_on_surface_variant" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_draft_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="未提交" android:background="#FFF3E0" android:paddingVertical="3dp" android:paddingHorizontal="10dp"
                            android:textColor="#E65100" android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== 销售流水 ===== -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📋 销售流水" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/md_on_surface" android:layout_marginBottom="8dp" />

                <androidx.cardview.widget.CardView android:layout_width="match_parent"
                    android:layout_height="match_parent" app:cardCornerRadius="12dp" app:cardElevation="1dp"
                    android:paddingStart="4dp" android:paddingEnd="4dp">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_sales_records"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
