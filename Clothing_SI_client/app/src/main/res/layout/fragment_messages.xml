<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@color/md_surface_container_low">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/header_bar_bg" android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="消息" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/md_on_surface" android:layout_centerInParent="true" />
        </RelativeLayout>

        <!-- MD3 Segmented Control -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_margin="16dp"
            android:background="@color/md_surface_container_high" android:padding="3dp">
            <TextView android:id="@+id/tab_chat" android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:gravity="center" android:text="聊天"
                android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/segment_tab_bg"
                android:textColor="@color/md_primary" />
            <TextView android:id="@+id/tab_appt" android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:gravity="center" android:text="预约"
                android:textSize="13sp"
                android:background="@drawable/segment_tab_bg"
                android:textColor="@color/md_on_surface_variant" />
        </LinearLayout>

        <!-- 聊天内容 -->
        <FrameLayout android:id="@+id/chat_content" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:visibility="visible"
            android:paddingHorizontal="16dp">
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="match_parent" app:cardCornerRadius="12dp"
                app:cardElevation="1dp" android:paddingStart="4dp" android:paddingEnd="4dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_chat_sessions"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- 预约内容 -->
        <FrameLayout android:id="@+id/appt_content" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:visibility="gone"
            android:paddingHorizontal="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- 待确认 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="待确认" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/md_on_surface" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1"
                    android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="1dp"
                    android:paddingStart="4dp" android:paddingEnd="4dp">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_appointments_pending"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </androidx.cardview.widget.CardView>

                <!-- 今日已确认 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="今日已确认" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/md_on_surface" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1"
                    app:cardCornerRadius="12dp" app:cardElevation="1dp"
                    android:paddingStart="4dp" android:paddingEnd="4dp">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_appointments_confirmed"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
