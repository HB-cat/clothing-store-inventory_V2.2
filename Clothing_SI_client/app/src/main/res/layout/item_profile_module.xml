<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingVertical="12dp"
    android:paddingStart="16dp" android:paddingEnd="12dp"
    android:gravity="center_vertical">

    <TextView android:id="@+id/tv_drag" android:layout_width="24dp"
        android:layout_height="wrap_content" android:text="⠿"
        android:textSize="16dp" android:textColor="#BDC3C7" android:gravity="center" />

    <TextView android:id="@+id/tv_icon" android:layout_width="32dp"
        android:layout_height="wrap_content" android:textSize="22dp"
        android:gravity="center" android:layout_marginEnd="10dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15dp"
            android:textStyle="bold" android:textColor="#2D3436" />
        <TextView android:id="@+id/tv_desc" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11dp"
            android:textColor="#95A5A6" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7"
        android:layout_marginStart="4dp" />

</LinearLayout>
