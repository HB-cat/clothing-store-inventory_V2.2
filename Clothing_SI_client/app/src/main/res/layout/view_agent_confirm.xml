<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/md_surface"
    android:elevation="10dp"
    android:padding="20dp">

    <!-- ===== 确认消息 ===== -->
    <TextView
        android:id="@+id/tv_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/md_on_surface"
        android:lineSpacingExtra="4dp"
        android:paddingBottom="16dp" />

    <!-- ===== 按钮行 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btn_confirm_no"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="取消"
            android:textSize="13sp"
            android:textColor="@color/md_on_surface_variant"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_confirm_yes"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="确认"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_primary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="10dp"
            android:background="@color/md_primary" />
    </LinearLayout>

</LinearLayout>
