<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:elevation="10dp"
    android:padding="16dp">
    <!-- 确认消息 -->
    <TextView android:id="@+id/tv_confirm_message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14dp" android:textColor="#2D3436"
        android:lineSpacingExtra="4dp" android:paddingBottom="14dp" />
    <!-- 按钮 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end">
        <TextView android:id="@+id/btn_confirm_no" android:layout_width="80dp" android:layout_height="36dp"
            android:text="取消" android:textSize="13dp" android:textColor="#95A5A6"
            android:gravity="center" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_confirm_yes" android:layout_width="80dp" android:layout_height="36dp"
            android:text="确认" android:textSize="13dp" android:textColor="#FFFFFF"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp"
            android:background="@drawable/confirm_btn_bg" />
    </LinearLayout>
</LinearLayout>
