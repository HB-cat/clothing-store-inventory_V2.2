<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@color/md_surface"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tv_product_name"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="14sp" android:textColor="@color/md_on_surface" />
    <TextView android:id="@+id/tv_product_price"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/md_on_surface_variant" />
</LinearLayout>
