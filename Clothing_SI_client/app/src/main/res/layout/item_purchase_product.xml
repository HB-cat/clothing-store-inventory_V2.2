<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="#FFFFFF"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tv_product_name"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="14dp" android:textColor="#2D3436" />
    <TextView android:id="@+id/tv_product_price"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12dp" android:textColor="#95A5A6" />
</LinearLayout>
