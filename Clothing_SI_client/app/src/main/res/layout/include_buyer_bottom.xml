<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center"
    android:paddingVertical="10dp" android:background="#FFFFFF"
    android:weightSum="4" android:elevation="4dp">
    <TextView android:id="@+id/bottom_home" android:layout_width="0dp" android:layout_height="40dp"
        android:layout_weight="1" android:gravity="center" android:text="首页"
        android:textSize="13dp" android:textColor="#95A5A6"
        android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/bottom_follow" android:layout_width="0dp" android:layout_height="40dp"
        android:layout_weight="1" android:gravity="center" android:text="关注"
        android:textSize="13dp" android:textColor="#95A5A6"
        android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/bottom_messages" android:layout_width="0dp" android:layout_height="40dp"
        android:layout_weight="1" android:gravity="center" android:text="消息"
        android:textSize="13dp" android:textColor="#95A5A6"
        android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/bottom_profile" android:layout_width="0dp" android:layout_height="40dp"
        android:layout_weight="1" android:gravity="center" android:text="我的"
        android:textSize="13dp" android:textColor="#95A5A6"
        android:clickable="true" android:focusable="true" />
</LinearLayout>
