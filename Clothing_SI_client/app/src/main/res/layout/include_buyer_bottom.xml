<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:orientation="horizontal" android:gravity="center"
    android:background="@color/md_surface"
    android:elevation="8dp"
    android:weightSum="4">
    <TextView android:id="@+id/bottom_home" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="🏠\n首页"
        android:textSize="12sp" android:lines="2" android:lineSpacingExtra="0dp"
        android:textColor="@color/md_on_surface_variant"
        android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/bottom_follow" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="❤️\n关注"
        android:textSize="11sp" android:lines="2" android:lineSpacingExtra="0dp"
        android:textColor="@color/md_on_surface_variant"
        android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/bottom_messages" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="💬\n消息"
        android:textSize="11sp" android:lines="2" android:lineSpacingExtra="0dp"
        android:textColor="@color/md_on_surface_variant"
        android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/bottom_profile" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="👤\n我的"
        android:textSize="11sp" android:lines="2" android:lineSpacingExtra="0dp"
        android:textColor="@color/md_on_surface_variant"
        android:clickable="true" android:focusable="true" />
</LinearLayout>
