<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp">
        <TextView android:id="@+id/tv_product_emoji" android:layout_width="72dp" android:layout_height="72dp"
            android:text="👕" android:gravity="center" android:textSize="36dp" android:background="@color/primary_light" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/tv_product_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="15dp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_product_wholesaler" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12dp" android:textColor="#95A5A6" />
            <TextView android:id="@+id/tv_product_price" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="16dp" android:textStyle="bold"
                android:textColor="@color/primary" android:layout_marginTop="4dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_wholesale"
            android:layout_width="wrap_content" android:layout_height="36dp" android:text="批发"
            app:cornerRadius="18dp" android:layout_gravity="center" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
