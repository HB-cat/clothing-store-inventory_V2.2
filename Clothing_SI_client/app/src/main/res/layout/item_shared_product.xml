<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp" app:cardElevation="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp">
        <TextView android:id="@+id/tv_product_emoji" android:layout_width="72dp" android:layout_height="72dp"
            android:text="👕" android:gravity="center" android:textSize="36sp"
            android:background="@color/md_primary_container" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView android:id="@+id/tv_product_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/md_on_surface" />
            <TextView android:id="@+id/tv_product_wholesaler" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/md_on_surface_variant" />
            <TextView android:id="@+id/tv_product_price" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/md_primary" android:layout_marginTop="4dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_wholesale"
            android:layout_width="wrap_content" android:layout_height="36dp" android:text="批发"
            app:cornerRadius="18dp" android:layout_gravity="center"
            android:background="@drawable/btn_gradient_primary" app:backgroundTint="@null"
            android:textColor="@color/md_on_primary" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
