<?xml version="1.0" encoding="utf-8"?>
<!--
  智能体聊天气泡 — MD3 风格
  layout_agent / layout_user 由 Java 控制显隐
  tv_bubble_text / tv_bubble_text_user 由 Java 填充
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ===== 智能体气泡（左侧，灰色） ===== -->
    <LinearLayout
        android:id="@+id/layout_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <!-- 智能体头像 -->
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="🤖"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/circle_agent_bg"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp" />

        <!-- 气泡内容（圆角 16dp MD3 风格） -->
        <TextView
            android:id="@+id/tv_bubble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:background="@color/md_surface_container_high"
            android:textSize="14sp"
            android:textColor="@color/md_on_surface"
            android:lineSpacingExtra="4dp"
            android:maxWidth="260dp"
            android:minHeight="36dp" />
    </LinearLayout>

    <!-- ===== 用户气泡（右侧，主题色） ===== -->
    <LinearLayout
        android:id="@+id/layout_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <!-- 气泡内容（圆角 16dp MD3 Primary） -->
        <TextView
            android:id="@+id/tv_bubble_text_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:background="@color/md_primary"
            android:textColor="@color/md_on_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:maxWidth="260dp"
            android:minHeight="36dp" />

        <!-- 用户头像 -->
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="👤"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/circle_bg"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
