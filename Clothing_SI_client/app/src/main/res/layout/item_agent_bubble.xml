<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 智能体气泡（左侧） -->
    <LinearLayout android:id="@+id/layout_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <!-- 智能体头像 -->
        <TextView android:layout_width="32dp" android:layout_height="32dp"
            android:text="🤖" android:textSize="16dp"
            android:gravity="center"
            android:background="@drawable/circle_agent_bg"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp" />

        <!-- 气泡内容 -->
        <TextView android:id="@+id/tv_bubble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@drawable/card_bg"
            android:textSize="14dp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="4dp"
            android:maxWidth="260dp" />
    </LinearLayout>

    <!-- 用户气泡（右侧） -->
    <LinearLayout android:id="@+id/layout_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="end"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <!-- 气泡内容 -->
        <TextView android:id="@+id/tv_bubble_text_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:background="@color/primary"
            android:textColor="@color/white"
            android:textSize="14dp"
            android:lineSpacingExtra="4dp"
            android:maxWidth="260dp" />

        <!-- 用户头像 -->
        <TextView android:layout_width="32dp" android:layout_height="32dp"
            android:text="👤" android:textSize="16dp"
            android:gravity="center"
            android:background="@drawable/circle_bg"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
