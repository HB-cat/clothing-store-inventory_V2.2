<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Avatar + Nickname -->
        <LinearLayout android:id="@+id/avatar_layout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:clickable="true" android:focusable="true"
            android:layout_marginBottom="12dp">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                <TextView android:layout_width="56dp" android:layout_height="56dp"
                    android:text="👤" android:textSize="28dp"
                    android:gravity="center" android:background="#FDEDEC" />
                <TextView android:layout_width="20dp" android:layout_height="20dp"
                    android:text="✎" android:textSize="11dp" android:textColor="#FFFFFF"
                    android:gravity="center" android:background="@drawable/circle_bg"
                    android:backgroundTint="#E85D3A"
                    android:layout_gravity="bottom|end" android:layout_marginEnd="0dp" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView android:id="@+id/tv_nickname" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="欣欣服装店"
                    android:textSize="18dp" android:textStyle="bold" android:textColor="#2D3436" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="点击修改昵称" android:textSize="12dp" android:textColor="#95A5A6" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sort hint -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="≡ 长按拖拽可排序" android:textSize="11dp"
            android:textColor="#BDC3C7" android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Module List -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginBottom="12dp">
            <!-- 经营分析 -->
            <androidx.cardview.widget.CardView android:id="@+id/module_analytics"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                android:layout_marginBottom="6dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⠿" android:textSize="16dp" android:textColor="#BDC3C7" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊" android:textSize="22dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="经营分析" android:textSize="15dp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="快报·趋势·画像" android:textSize="11dp" android:textColor="#95A5A6"
                        android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- 商品管理 -->
            <androidx.cardview.widget.CardView android:id="@+id/module_products"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                android:layout_marginBottom="6dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⠿" android:textSize="16dp" android:textColor="#BDC3C7" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👕" android:textSize="22dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="商品管理" android:textSize="15dp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="列表·搜索·筛选" android:textSize="11dp" android:textColor="#95A5A6" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- 添加商品 -->
            <androidx.cardview.widget.CardView android:id="@+id/module_add_product"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                android:layout_marginBottom="6dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⠿" android:textSize="16dp" android:textColor="#BDC3C7" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="➕" android:textSize="22dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="添加商品" android:textSize="15dp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="三步流程·组合库存" android:textSize="11dp" android:textColor="#95A5A6" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- 库存查看 -->
            <androidx.cardview.widget.CardView android:id="@+id/module_stock"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                android:layout_marginBottom="6dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⠿" android:textSize="16dp" android:textColor="#BDC3C7" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📦" android:textSize="22dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="库存查看" android:textSize="15dp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="实时库存·属性组合" android:textSize="11dp" android:textColor="#95A5A6" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- 分类管理 -->
            <androidx.cardview.widget.CardView android:id="@+id/module_categories"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                android:layout_marginBottom="6dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⠿" android:textSize="16dp" android:textColor="#BDC3C7" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📂" android:textSize="22dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="分类管理" android:textSize="15dp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="动态增删·拖拽排序" android:textSize="11dp" android:textColor="#95A5A6" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- 属性管理 -->
            <androidx.cardview.widget.CardView android:id="@+id/module_attributes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                android:layout_marginBottom="6dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⠿" android:textSize="16dp" android:textColor="#BDC3C7" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏷️" android:textSize="22dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="属性管理" android:textSize="15dp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="颜色·尺码·材质" android:textSize="11dp" android:textColor="#95A5A6" android:layout_marginEnd="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Settings -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="20dp"
            app:cardElevation="2dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🛠️" android:textSize="20dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="程序设置" android:textSize="15dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EAED" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔔" android:textSize="20dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="通知管理" android:textSize="15dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EAED" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🤖" android:textSize="20dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="智能体设置" android:textSize="15dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EAED" />
                <LinearLayout android:id="@+id/settings_data"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💾" android:textSize="20dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="数据管理" android:textSize="15dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Help -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="20dp"
            app:cardElevation="2dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📖" android:textSize="20dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="使用帮助" android:textSize="15dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EAED" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ℹ️" android:textSize="20dp" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="关于" android:textSize="15dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="14dp" android:textColor="#BDC3C7" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="退出登录"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="28dp" app:strokeColor="@color/primary"
            android:textColor="@color/primary" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="--- HeBen_Cat ---" android:textSize="11dp"
            android:textColor="#BDC3C7" android:gravity="center"
            android:layout_marginTop="12dp" android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
