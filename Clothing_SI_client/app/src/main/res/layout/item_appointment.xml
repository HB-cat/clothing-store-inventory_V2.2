<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@color/md_surface"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/tv_appt_time"
        android:layout_width="44dp" android:layout_height="wrap_content"
        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/md_primary"
        android:gravity="center_horizontal" android:layout_marginEnd="12dp"
        android:lineSpacingExtra="2dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_appt_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/md_on_surface" />
        <TextView android:id="@+id/tv_appt_info"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/md_on_surface_variant"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/layout_appt_actions"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginStart="8dp">
        <TextView android:id="@+id/btn_confirm_appt"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✓" android:textSize="16sp" android:textColor="@color/md_primary"
            android:gravity="center"
            android:background="@drawable/btn_gradient_container"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_reject_appt"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✗" android:textSize="16sp" android:textColor="@color/md_error"
            android:gravity="center"
            android:background="@drawable/circle_bg" android:backgroundTint="@color/md_error_container"
            android:clickable="true" android:focusable="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView android:id="@+id/tv_appt_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:paddingVertical="4dp" android:paddingHorizontal="10dp"
        android:visibility="gone" />
</LinearLayout>
