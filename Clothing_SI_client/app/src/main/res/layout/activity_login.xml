<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface_container_low"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- ===== Logo 区域（上移更紧凑） ===== -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="👕"
            android:textSize="40sp"
            android:gravity="center"
            android:background="@color/md_primary_container"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服装进销存"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="欢迎回来，请登录你的账号"
            android:textSize="14sp"
            android:textColor="@color/md_on_surface_variant"
            android:layout_marginBottom="36dp" />

        <!-- ===== 表单卡片 ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/md_surface"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 用户名 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="用户名"
                    app:boxStrokeColor="@color/md_primary"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/md_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textSize="15sp"
                        android:paddingVertical="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 密码 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="密码"
                    app:passwordToggleEnabled="true"
                    app:boxStrokeColor="@color/md_primary"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/md_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:imeOptions="actionDone"
                        android:textSize="15sp"
                        android:paddingVertical="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 记住密码 -->
                <CheckBox
                    android:id="@+id/cb_remember_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="记住密码"
                    android:textSize="13sp"
                    android:textColor="@color/md_on_surface_variant"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp" />

                <!-- 登录按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="登录"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    android:background="@drawable/btn_gradient_primary" app:backgroundTint="@null"
                    android:textColor="@color/md_on_primary"
                    android:letterSpacing="0.03" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 注册链接 -->
        <TextView
            android:id="@+id/tv_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="还没有账号？去注册"
            android:textColor="@color/md_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- 底部版本信息 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clothing-SI v2.2"
            android:textSize="11sp"
            android:textColor="@color/md_outline_variant"
            android:layout_marginTop="24dp" />

        <!-- 隐藏占位（兼容 Java 代码） -->
        <TextView
            android:id="@+id/tv_to_login"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp" />

    </LinearLayout>
</ScrollView>
