<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface_container_low"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- ===== 标题 ===== -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="👕"
            android:textSize="40sp"
            android:gravity="center"
            android:background="@color/md_primary_container"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="创建账号"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择你的角色开始使用"
            android:textSize="14sp"
            android:textColor="@color/md_on_surface_variant"
            android:layout_marginBottom="24dp" />

        <!-- ===== 角色选择芯片组（MD3 Segmented 风格） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:background="@color/md_surface_container_high"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_seller"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="零售商"
                android:textSize="13sp"
                app:cornerRadius="21dp"
                app:strokeWidth="0dp"
                android:backgroundTint="@color/md_surface"
                android:textColor="@color/md_primary"
                android:tag="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_wholesaler"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="批发商"
                android:textSize="13sp"
                app:cornerRadius="21dp"
                app:strokeWidth="0dp"
                android:backgroundTint="@color/md_surface"
                android:textColor="@color/md_on_surface_variant"
                android:tag="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_buyer"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:text="买家"
                android:textSize="13sp"
                app:cornerRadius="21dp"
                app:strokeWidth="0dp"
                android:backgroundTint="@color/md_surface"
                android:textColor="@color/md_on_surface_variant"
                android:tag="3" />
        </LinearLayout>

        <!-- ===== 表单卡片 ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/md_surface"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 店铺名称 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="店铺名称"
                    app:boxStrokeColor="@color/md_primary"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/md_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:paddingVertical="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 密码 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="密码（8-12位）"
                    app:passwordToggleEnabled="true"
                    app:boxStrokeColor="@color/md_primary"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/md_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:paddingVertical="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 注册按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="注册"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    android:backgroundTint="@color/md_primary"
                    android:textColor="@color/md_on_primary"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.03" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 登录链接 -->
        <TextView
            android:id="@+id/tv_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已有账号？去登录"
            android:textColor="@color/md_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- 底部版本 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clothing-SI v2.2"
            android:textSize="11sp"
            android:textColor="@color/md_outline_variant"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
