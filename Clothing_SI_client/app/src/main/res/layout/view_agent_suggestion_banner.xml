<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/suggestion_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/md_primary_container"
    android:elevation="2dp"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/banner_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:textSize="18sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/banner_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textColor="@color/md_on_primary_container"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/banner_action"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="试试 →"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/md_on_primary"
        android:background="@color/md_primary"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/banner_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="✕"
        android:textSize="14sp"
        android:textColor="@color/md_outline"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="6dp" />
</LinearLayout>
