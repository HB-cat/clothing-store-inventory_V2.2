<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/md_surface_container_low">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/header_bar_bg" android:paddingHorizontal="16dp">
            <TextView android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp"
                android:text="‹" android:textSize="20sp" android:textColor="@color/md_on_surface"
                android:gravity="center" android:background="@drawable/circle_bg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="编辑草稿" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/md_on_surface" android:layout_centerInParent="true" />
            <TextView android:id="@+id/btn_submit_top" android:layout_width="36dp" android:layout_height="36dp"
                android:text="✔️" android:textSize="16sp" android:textColor="@color/md_on_surface"
                android:gravity="center" android:background="@drawable/circle_bg"
                android:layout_alignParentEnd="true" android:clickable="true" android:focusable="true" />
        </RelativeLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 买家姓名 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="买家姓名" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="@color/md_on_surface_variant" android:layout_marginBottom="6dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp"
                    android:layout_marginBottom="16dp" android:hint="输入买家姓名">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_buyer_name"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 商品列表 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="商品列表" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/md_on_surface" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="1dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:stretchColumns="*">
                            <TableRow android:paddingVertical="8dp">
                                <TextView android:text="商品" android:textStyle="bold" android:textSize="12sp"
                                    android:textColor="@color/md_on_surface_variant" android:layout_span="2" />
                                <TextView android:text="数量" android:textStyle="bold" android:textSize="12sp"
                                    android:textColor="@color/md_on_surface_variant" android:gravity="center" />
                                <TextView android:text="单价" android:textStyle="bold" android:textSize="12sp"
                                    android:textColor="@color/md_on_surface_variant" android:gravity="end" />
                                <TextView android:text="小计" android:textStyle="bold" android:textSize="12sp"
                                    android:textColor="@color/md_on_surface_variant" android:gravity="end" />
                            </TableRow>
                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:background="@color/md_outline_variant" />
                        </TableLayout>
                        <LinearLayout android:id="@+id/layout_draft_items"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_product_to_draft"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:text="➕ 添加商品" android:textSize="13sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="22dp" app:strokeColor="@color/md_primary"
                    android:textColor="@color/md_primary" android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btn_draft_submit"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="提交草稿" android:textSize="16sp" android:textStyle="bold"
                    app:cornerRadius="26dp"
                    android:background="@drawable/btn_gradient_primary" app:backgroundTint="@null"
                    android:textColor="@color/md_on_primary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
