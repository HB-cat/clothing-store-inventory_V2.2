<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/md_surface"
    android:elevation="8dp"
    android:padding="12dp">

    <!-- ===== 标题栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 智能体"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_agent_full"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="⤢"
                android:textSize="14sp"
                android:textColor="@color/md_on_surface_variant"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/circle_bg" />
            <TextView
                android:id="@+id/btn_agent_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="✕"
                android:textSize="14sp"
                android:textColor="@color/md_on_surface_variant"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 输入行 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/et_agent_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="输入指令..."
            android:textSize="13sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@color/md_surface_container_high"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_agent_send"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="➤"
            app:cornerRadius="18dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_gradient_primary" app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
