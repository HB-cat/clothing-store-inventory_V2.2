<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/layout_message_other" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginBottom="12dp" android:visibility="gone">
        <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="👩"
            android:gravity="center" android:background="#FDEDEC" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/tv_other_content" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:background="@drawable/card_bg" android:textSize="14dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/layout_message_mine" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_gravity="end" android:layout_marginBottom="12dp" android:visibility="gone">
        <TextView android:id="@+id/tv_mine_content" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:background="#E85D3A" android:textColor="#FFFFFF" android:textSize="14dp" />
        <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="👤"
            android:gravity="center" android:background="#FDEDEC" android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
