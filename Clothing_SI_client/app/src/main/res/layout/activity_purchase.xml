<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface_container_low">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/header_bar_bg"
            android:paddingHorizontal="16dp">
            <TextView android:id="@+id/btn_back" android:layout_width="36dp" android:layout_height="36dp"
                android:text="‹" android:textSize="20sp" android:textColor="@color/md_on_surface"
                android:gravity="center" android:background="@drawable/circle_bg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="进货入库" android:textSize="17sp" android:textStyle="bold"
                android:textColor="@color/md_on_surface" android:layout_centerInParent="true" />
        </RelativeLayout>

        <!-- MD3 Segmented Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_margin="16dp" android:layout_marginBottom="8dp"
            android:background="@color/md_surface_container_high" android:padding="3dp">
            <TextView android:id="@+id/tab_my_products" android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:gravity="center" android:text="我的商品"
                android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/segment_tab_bg" android:textColor="@color/md_primary"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tab_new_product" android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:gravity="center" android:text="新建并入库"
                android:textSize="13sp"
                android:background="@drawable/segment_tab_bg" android:textColor="@color/md_on_surface_variant"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/tab_wholesale" android:layout_width="0dp" android:layout_height="38dp"
                android:layout_weight="1" android:gravity="center" android:text="批发商共享库"
                android:textSize="13sp"
                android:background="@drawable/segment_tab_bg" android:textColor="@color/md_on_surface_variant"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tab 1: 我的商品 -->
                <LinearLayout android:id="@+id/panel_my_products"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp"
                        android:layout_marginBottom="8dp" android:hint="🔍 搜索已有商品">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_search_product"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp" app:cardElevation="1dp"
                        android:paddingStart="4dp" android:paddingEnd="4dp">
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_purchase_products"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:maxHeight="200dp" />
                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="12dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:hint="数量"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_purchase_qty"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="6dp"
                            android:hint="进货单价"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_purchase_price_input"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Tab 2: 新建并入库 -->
                <LinearLayout android:id="@+id/panel_new_product"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp"
                        android:layout_marginBottom="8dp" android:hint="商品名称">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_new_name"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:id="@+id/tv_new_category"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:gravity="center_vertical" android:paddingHorizontal="14dp"
                        android:background="@drawable/segment_bg" android:layout_marginBottom="8dp"
                        android:text="选择分类（点击选择）" android:textSize="14sp"
                        android:textColor="@color/md_on_surface_variant"
                        android:clickable="true" android:focusable="true" />
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:hint="进价"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_new_purchase_price"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="6dp"
                            android:hint="售价"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_new_selling_price"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="numberDecimal" android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp"
                        android:layout_marginTop="8dp" android:hint="入库数量">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_new_qty"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Tab 3: 批发商共享 -->
                <LinearLayout android:id="@+id/panel_wholesale"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/md_primary" app:boxStrokeWidth="1.5dp"
                        android:hint="🔍 搜索共享商品">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_wholesale_search"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="从批发商共享池选择商品进货"
                        android:textSize="13sp" android:textColor="@color/md_on_surface_variant"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                <!-- Summary + Submit -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp" app:cardElevation="1dp">
                    <TextView android:id="@+id/tv_purchase_summary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="请选择商品和数量"
                        android:padding="16dp" android:textSize="14sp"
                        android:textColor="@color/md_on_surface" />
                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton android:id="@+id/btn_confirm_purchase"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="确认入库" android:textSize="16sp" android:textStyle="bold"
                    android:background="@drawable/btn_gradient_primary" app:backgroundTint="@null"
                    android:textColor="@color/md_on_primary"
                    android:layout_marginVertical="16dp" />

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⬆️ 切换到「批发商共享库」可从上游导入商品"
                    android:textSize="12sp" android:textColor="@color/md_on_surface_variant"
                    android:gravity="center" android:layout_marginBottom="8dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
