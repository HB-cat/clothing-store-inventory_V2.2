<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/md_surface"
    android:paddingTop="0dp">

    <!-- ===== 顶部拖拽指示条 ===== -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@color/md_outline_variant"
        android:alpha="0.5" />

    <!-- ===== 标题栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 智能体助手"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/md_on_surface" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_sheet_fullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="⤢"
                android:textSize="16sp"
                android:textColor="@color/md_on_surface_variant"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/circle_bg"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_sheet_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="✕"
                android:textSize="16sp"
                android:textColor="@color/md_on_surface_variant"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/circle_bg" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant" />

    <!-- ===== 对话区域 ===== -->
    <ScrollView
        android:id="@+id/scroll_sheet_chat"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:padding="12dp"
        android:paddingBottom="4dp"
        android:background="@color/md_surface_container_low">

        <LinearLayout
            android:id="@+id/chat_sheet_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant" />

    <!-- ===== 输入栏（Pill 风格） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md_surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusTopStart="24dp"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxStrokeColor="@color/md_outline"
            app:boxStrokeWidth="1dp"
            android:hint="输入指令...">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sheet_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp"
                android:background="@color/md_surface_container_low"
                android:paddingVertical="10dp"
                android:paddingHorizontal="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="➤"
            android:textSize="16sp"
            app:cornerRadius="22dp"
            android:background="@drawable/btn_gradient_primary" app:backgroundTint="@null"
            android:textColor="@color/md_on_primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
