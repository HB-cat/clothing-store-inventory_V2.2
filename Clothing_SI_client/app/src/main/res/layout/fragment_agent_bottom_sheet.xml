<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingTop="0dp">

    <!-- 顶部拖拽指示条 -->
    <View android:layout_width="36dp" android:layout_height="4dp"
        android:layout_gravity="center" android:layout_marginTop="8dp"
        android:background="#D5D8DC" android:alpha="0.6" />

    <!-- 标题栏 -->
    <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:paddingHorizontal="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🤖 智能体助手" android:textSize="16dp" android:textStyle="bold"
            android:textColor="#2D3436" android:layout_centerVertical="true" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true">
            <TextView android:id="@+id/btn_sheet_expand"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="⤢" android:textSize="16dp" android:textColor="#95A5A6"
                android:gravity="center" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/btn_sheet_close"
                android:layout_width="32dp" android:layout_height="32dp"
                android:text="✕" android:textSize="16dp" android:textColor="#95A5A6"
                android:gravity="center" android:clickable="true" android:focusable="true"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </RelativeLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EAED" />

    <!-- 对话区域 -->
    <ScrollView android:id="@+id/scroll_sheet_chat"
        android:layout_width="match_parent" android:layout_height="280dp"
        android:padding="12dp" android:paddingBottom="0dp">
        <LinearLayout android:id="@+id/chat_sheet_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EAED"
        android:layout_marginTop="4dp" />

    <!-- 输入栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#FFFFFF" android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#E8EAED" app:boxStrokeWidth="1dp"
            android:hint="输入指令...">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sheet_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="3" android:inputType="textMultiLine"
                android:textSize="14dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_send"
            android:layout_width="42dp" android:layout_height="42dp"
            android:text="➤" android:textSize="16dp"
            app:cornerRadius="21dp"
            android:backgroundTint="#E85D3A" android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
